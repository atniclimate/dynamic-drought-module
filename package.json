{
  "name": "dynamic-drought-module",
  "private": true,
  "version": "0.6.26",
  "type": "module",
  "description": "Embeddable static web map with North American drought context, recent satellite imagery, and detailed United States hazard and telemetry views, deepest in the Pacific Northwest.",
  "license": "PolyForm-Strict-1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:serial": "playwright test --workers=1",
    "test:drift-contract": "node --test tests/upstream-drift-contract.test.mjs",
    "test:minimap-geometry": "node --test tests/minimap-geometry-artifact.test.mjs",
    "test:style-expressions": "node --test tests/style-expressions.test.mjs",
    "test:live-receipts": "node --test tests/live-receipts.test.mjs",
    "test:worker-receipts": "node --test tests/worker-receipts.test.mjs",
    "test:source-health": "node --test tests/source-health.test.mjs",
    "test:boundary-boots": "node --test tests/boundary-boot-inventory.test.mjs",
    "test:pure-lane": "node --test tests/pure-lane-inventory.test.mjs",
    "test:report": "playwright show-report",
    "scan:emdash": "node scripts/scan-emdash.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:resources": "node scripts/check-resource-catalog.mjs",
    "check:public-tree": "node scripts/check-public-tree.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:places": "node scripts/check-places-artifact.mjs",
    "check:coverage": "node scripts/generate-coverage-matrix.mjs --check",
    "check:vocabulary": "node scripts/check-surface-vocabulary.mjs",
    "check:activation": "node scripts/check-activation-budget.mjs",
    "check:renderer": "node scripts/check-renderer-version.mjs",
    "check:landscape-schema": "node scripts/validate-landscape-artifact.mjs scripts/landscape/tests/fixtures/corrected/snapshot_terrain_l3.json && node scripts/validate-landscape-artifact.mjs public/data/landscape-signature-pnw.json",
    "build:coverage-matrix": "node scripts/generate-coverage-matrix.mjs",
    "check:all": "npm run scan:emdash && npm run check:public-tree && npm run check:resources && npm run check:places && npm run check:coverage && npm run check:vocabulary && npm run check:landscape-schema && npm run check:enso && npm run test:drift-contract && npm run test:live-receipts && npm run test:worker-receipts && npm run test:source-health && npm run test:boundary-boots && npm run test:minimap-geometry && npm run test:style-expressions && npm run test:pure-lane && npm run check:renderer",
    "gate": "npm run build && npm run check:bundle && npm run check:activation && npm run check:all",
    "gate:nobuild": "npm run typecheck && npm run check:all",
    "verify:quick": "npm run typecheck && npm run scan:emdash && npm run check:vocabulary && npm run check:coverage",
    "verify:pure": "playwright test -c playwright.pure.config.ts --workers=1",
    "verify:smoke": "npm run gate && playwright test --workers=1 --reporter=list tests/boot.spec.ts tests/ux1-surfaces.spec.ts tests/url-state.spec.ts tests/cluster-controller-integration.spec.ts tests/temporal-axis.spec.ts tests/impact-panel-a11y.spec.ts tests/legend.spec.ts tests/conditions-strip.spec.ts tests/mobile-sheet.spec.ts tests/embed-viewport.spec.ts tests/interface-responsive.spec.ts tests/s4-minimap.spec.ts",
    "build:enso": "node scripts/build-enso-snapshot.mjs",
    "check:enso": "node scripts/validate-enso-snapshot.mjs public/data/enso-indices.json",
    "build:cdm": "node scripts/build-cdm-snapshot.mjs",
    "build:landscape": ".venv\\Scripts\\python.exe -m scripts.landscape && node scripts/validate-landscape-artifact.mjs public/data/landscape-signature-pnw.json",
    "build:landscape:smoke": ".venv\\Scripts\\python.exe -m scripts.landscape --smoke --output scripts/.cache/landscape-smoke.json && node scripts/validate-landscape-artifact.mjs scripts/.cache/landscape-smoke.json",
    "build:places": "node scripts/build-places.mjs",
    "build:ecoregion-tiles": "node scripts/build-ecoregion-tiles.mjs",
    "build:fuels-tiles": "node scripts/build-fuels-tiles.mjs",
    "build:whp-tiles": "node scripts/build-whp-tiles.mjs",
    "build:power-tiles": "node scripts/build-power-tiles.mjs",
    "build:structures-tiles": "node scripts/build-structures-tiles.mjs",
    "build:minimap-geometry": "node scripts/build-minimap-geometry.mjs",
    "build:minimap-whp": "node scripts/build-minimap-whp.mjs",
    "build:states": "node scripts/build-states.mjs",
    "build:tribal-roster": "node scripts/build-tribal-roster.mjs",
    "check:drift": "node scripts/check-upstream-drift.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "check:source-health": "node scripts/source-health.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.9.3",
    "maplibre-gl": "6.6.0",
    "pmtiles": "^4.4.1",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "fflate": "0.8.3",
    "geojson-vt": "^4.0.3",
    "geotiff": "^3.0.5",
    "mapshaper": "^0.7.22",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.3",
    "vt-pbf": "^3.1.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "@ngageoint/geopackage": "npm:noop2@^2.0.0"
  }
}
