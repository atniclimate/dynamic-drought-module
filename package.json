{
  "name": "dynamic-drought-module",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Embeddable, serverless web map for drought, hydrography, ecological boundaries, wildfire activity, and live water and snowpack telemetry. Pacific Northwest focus.",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:serial": "playwright test --workers=1",
    "test:report": "playwright show-report",
    "scan:emdash": "node scripts/scan-emdash.mjs",
    "gate": "npm run build && npm run scan:emdash",
    "build:enso": "node scripts/build-enso-snapshot.mjs",
    "build:ecoregion-tiles": "node scripts/build-ecoregion-tiles.mjs",
    "build:states": "node scripts/build-states.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.0",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/geojson": "^7946.0.14",
    "geojson-vt": "^4.0.3",
    "mapshaper": "^0.7.22",
    "typescript": "^5.6.0",
    "vite": "^8.1.3",
    "vt-pbf": "^3.1.3"
  }
}
