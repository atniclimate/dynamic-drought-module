{
  "name": "dynamic-drought-module",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Embeddable static web map with North American drought context, recent satellite imagery, and detailed United States hazard and telemetry views, deepest in the Pacific Northwest.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=chromium --project=chromium-interaction --project=chromium-3d",
    "test:serial": "playwright test --workers=1 --project=chromium --project=chromium-interaction --project=chromium-3d",
    "test:drift-contract": "node --test tests/upstream-drift-contract.test.mjs",
    "test:minimap-geometry": "node --test tests/minimap-geometry-artifact.test.mjs",
    "test:style-expressions": "node --test tests/style-expressions.test.mjs",
    "test:live-receipts": "node --test tests/live-receipts.test.mjs",
    "test:worker-receipts": "node --test tests/worker-receipts.test.mjs",
    "test:source-health": "node --test tests/source-health.test.mjs",
    "test:boundary-boots": "node --test tests/boundary-boot-inventory.test.mjs",
    "test:pure-lane": "node --test tests/pure-lane-inventory.test.mjs",
    "test:bundle-size": "node --test tests/check-bundle-size.test.mjs",
    "test:escape-html": "node --test tests/escape-html.test.mjs",
    "test:guards": "node --test tests/guards.test.mjs",
    "test:fetch-budget": "node --test tests/fetch-budget.test.mjs",
    "test:chunk-retry": "node --test tests/chunk-retry.test.mjs",
    "test:place-return": "node --test tests/place-return.test.mjs",
    "test:boot-idle-seam": "node --test tests/boot-idle-seam.test.mjs",
    "test:raster-contract": "node --test tests/raster-readiness-contract.test.mjs",
    "test:hillshade-reactivation": "node --test tests/hillshade-reactivation.test.mjs",
    "test:sst-frame-readiness": "node --test tests/sst-frame-readiness.test.mjs",
    "test:sleep-inventory": "node --test tests/sleep-inventory.test.mjs",
    "test:mode-switch-report": "node --test tests/mode-switch-cost-report.test.mjs",
    "test:lanes": "node --test tests/test-lanes.test.mjs",
    "test:preset-pressed": "node --test tests/preset-pressed.test.mjs",
    "test:map-chrome-contract": "node --test tests/map-chrome-contract.test.mjs",
    "test:chrome-n-modes": "node --test tests/chrome-n-modes.test.mjs",
    "test:contrast-contract": "node --test tests/contrast-contract.test.mjs",
    "test:text-tokens": "node --test tests/text-tokens.test.mjs",
    "test:popup-frame": "node --test tests/popup-frame.test.mjs",
    "test:coordinator-collect": "node --test tests/interaction-coordinator-collect.test.mjs",
    "test:pmtiles-stream-writer": "node --test tests/pmtiles-leaf-writer.test.mjs",
    "test:footer-version-mechanism": "node --test tests/footer-version-mechanism.test.mjs",
    "test:coordinator-model": "node --test tests/interaction-coordinator-model.test.mjs tests/telemetry-keyboard.test.mjs",
    "test:activation-selftest": "node --test tests/activation-budget-selftest.test.mjs",
    "test:briefing-truth": "node --test tests/briefing-truth.test.mjs",
    "test:fire3d-ribbon": "node --test tests/fire3d-ribbon-lifecycle.test.mjs",
    "test:place-popups": "node --test tests/place-popups.test.mjs",
    "test:stale-generation": "node --test tests/stale-generation.test.mjs",
    "test:minimap-wildfire-loaded": "node --test tests/minimap-wildfire-loaded.test.mjs",
    "test:layer-activation-cancel": "node --test tests/layer-activation-cancel.test.mjs",
    "test:place-label-nifc-model": "node --experimental-transform-types --test tests/place-label-nifc-model.test.mjs",
    "test:fire3d-ribbon-read": "node --test tests/fire3d-ribbon-read.test.mjs",
    "test:flow-grib-decode": "node --test tests/flow-grib-decode.test.mjs",
    "test:flow-nodd": "node --test tests/flow-nodd.test.mjs",
    "test:flow-advect": "node --test tests/flow-advect.test.mjs",
    "test:flow-still": "node --test tests/flow-still.test.mjs",
    "test:flow-plausibility": "node --test tests/flow-plausibility.test.mjs",
    "test:third-party-notices": "node --test tests/third-party-notices.test.mjs",
    "test:hillshade-abort": "node --test tests/hillshade-abort.test.mjs",
    "test:layer-set-boot-only": "node --test tests/layer-set-boot-only.test.mjs",
    "test:flow-wire": "node --test tests/flow-wire.test.mjs tests/enso-flow-announcement.test.mjs tests/enso-flow-stamps.test.mjs tests/flow-mode-url.test.mjs",
    "test:browser-offline": "node --test tests/browser-offline.test.mjs",
    "test:coordinator-frame-offline": "node --test tests/coordinator-frame-offline.test.mjs",
    "test:report": "playwright show-report",
    "measure:mode-switch": "playwright test --project=chromium-measure --workers=1 --reporter=list tests/mode-switch-cost.spec.ts",
    "measure:flow": "playwright test --project=chromium-measure --workers=1 tests/flow-measure.spec.ts",
    "scan:emdash": "node scripts/scan-emdash.mjs",
    "lint": "biome lint",
    "check:links": "node scripts/check-links.mjs",
    "check:resources": "node scripts/check-resource-catalog.mjs",
    "check:public-tree": "node scripts/check-public-tree.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:places": "node scripts/check-places-artifact.mjs",
    "check:coverage": "node scripts/generate-coverage-matrix.mjs --check",
    "check:vocabulary": "node scripts/check-surface-vocabulary.mjs",
    "check:activation": "node scripts/check-activation-budget.mjs",
    "check:renderer": "node scripts/check-renderer-version.mjs",
    "check:citations": "node scripts/check-citation-manifest.mjs",
    "check:key-types": "node scripts/check-key-types.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit && node tests/types/check-context-literal-typo.mjs && node tests/types/check-popup-model-invalid.mjs",
    "strip:sourcemaps": "node scripts/strip-published-sourcemaps.mjs",
    "check:landscape-schema": "node scripts/validate-landscape-artifact.mjs scripts/landscape/tests/fixtures/corrected/snapshot_terrain_l3.json && node scripts/validate-landscape-artifact.mjs public/data/landscape-signature-pnw.json",
