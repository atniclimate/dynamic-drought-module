# OS / editor noise
.DS_Store
Thumbs.db
*.log
*.swp
*~

# Secrets
.env
.env.*
!.env.example

# Build output / dependencies
node_modules/
dist/
.vite/

# Python build-time toolchain for the P9 landscape signature (build-time only,
# never shipped to the browser; the client consumes only the baked JSON snapshot)
.venv/
__pycache__/
*.pyc

# P9 raster download / windowed-read cache (large; fetched at build time, not committed)
scripts/.cache/

# Local data-building output
tiles-staging/

# Playwright browser-verification session artifacts
.playwright-cli/

# Playwright smoke-suite run artifacts (browsers install to a global cache,
# not into the repository; only per-run output lands here)
test-results/
playwright-report/
blob-report/

# wrangler dev local state (workers/proxy)
workers/proxy/.wrangler/

# Local agent, session, planning, and research material. These files may stay
# in a working copy, but they are not part of the public application source.
**/AGENTS.md
**/CLAUDE.md
!/CLAUDE.md
**/*HANDOFF*.md
**/*POST_MORTEM*.md
**/*POST-MORTEM*.md
/KICKOFF.md
/ORIGIN.md
/.agent/
/.agents/
/.claude/
/.codex/
/.handoff/
/drought-region-maps/
# 2026-09-07: planning/ is local EXCEPT the four paths the roadmap's authority
# block names as live ledgers (docs/ROADMAP.yaml, `authority:`). Those carry
# the DR- decision register, the FE- defect ledger that src/styles/app.css
# cites, the user-research inputs, and the newest handoff. Everything else
# under planning/ (the deep-dive and foundations dumps, archive, run logs)
# stays untracked. `/planning/*` rather than `/planning/` so the negations
# below can reach inside the directory.
/planning/*
!/planning/decisions/
!/planning/qa/
!/planning/user-research/
!/planning/handoffs/
/planning/handoffs/*
!/planning/handoffs/2026-09-04.md
/post-mortem/
/research/
/reviews/
/skills/
*.tasks.output

# Local product planning and execution receipts
/docs/IDEAS.md
/docs/SOURCES_CATALOG.yaml
/docs/SUCCESSOR_PLAN.md
/docs/handoffs/
/docs/prompts/
**/MODULE_TRACKING.yaml

# Preserved untracked evidence, never committed
/fire3d-evidence/

# Reconciliation working set (2026-09-07): the four documents under
# .planning/ are tracked; the scout JSON, traces and scratch under trace/
# are regenerable and stay local.
/.planning/trace/
