# Parity baselines and their manifest are byte-frozen: no end-of-line
# conversion anywhere (the tests compare sha256 and raw bytes).
scripts/landscape/tests/fixtures/legacy/* -text
tests/fixtures/flow/*.idx -text
scripts/landscape/tests/fixtures/synthetic/* binary
scripts/landscape/tests/fixtures/corrected/* -text
scripts/landscape/tests/fixtures/delta-manifest.json -text
scripts/landscape/tests/fixtures/landcover-fuels/* -text
scripts/landscape/tests/fixtures/soil/* -text
scripts/landscape/tests/fixtures/terrain-extension/* -text
scripts/landscape/intermediates/** -text
public/data/landscape-signature-pnw.json -text
# The NOAA NODD fixtures are served byte for byte by the routine-boot stub
# (tests/helpers.ts) and checked by length and hash: no end-of-line conversion.
tests/fixtures/flow/*.idx -text
tests/fixtures/flow/reference.json -text
# The notices file and its shipped copy are compared byte for byte and read line
# by line (tests/third-party-notices.test.mjs): LF on every checkout.
THIRD-PARTY-NOTICES.md text eol=lf
public/THIRD-PARTY-NOTICES.md text eol=lf
.githooks/* text eol=lf
